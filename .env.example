# Local dev environment (Spec §9). Copy to .env and fill in.

# Timezone for n8n (IANA). Matches clinics.timezone in the schema.
TZ=Asia/Karachi

# n8n credential encryption key. Generate: openssl rand -hex 32
# Keep this stable so saved credentials survive container recreation.
N8N_ENCRYPTION_KEY=

# ngrok tunnel (dev only). Token: https://dashboard.ngrok.com
NGROK_AUTHTOKEN=
# After ngrok is up, set this to the public https URL (or a static domain)
# so n8n builds correct webhook URLs, then restart n8n.
WEBHOOK_URL=

# Local Postgres + pgvector (db service). For production, point these at a
# Supabase cloud connection string instead — n8n's Postgres node is unchanged.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=clinic

# App credentials (see docs/credentials-setup.md).
# In n8n these go in the Credentials UI; the copies here are for standalone
# scripts (e.g. the knowledge-base embedding loader).

# LLM — Claude (generation). Haiku 4.5 = cheapest capable, supports strict JSON.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Embeddings — Anthropic has no embeddings API; this matches vector(1536) in db/schema.sql.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# WhatsApp Cloud API (Meta). VERIFY_TOKEN is any random string you also paste
# into Meta's webhook config.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Google Calendar is connected inside n8n (OAuth2), not here.
# The per-clinic calendar ID lives in the clinics.google_calendar_id column.
